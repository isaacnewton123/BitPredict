# ---------------------------------------------------------------
# BitPredict environment variables
# Copy to .env.local and fill in. Never commit real secrets.
# ---------------------------------------------------------------

# Database (libSQL / SQLite). Local file by default; can point to Turso (libsql://...) later.
DATABASE_URL=file:./data/bitpredict.db
# Only needed for remote libSQL (Turso)
DATABASE_AUTH_TOKEN=

# Public app URL (used in Nostr notes and NIP-98 auth URL checks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# HMAC secret for signing auth challenges & session cookies (required in production)
AUTH_SECRET=replace-with-32-byte-hex-secret

# AI Provider ("auto", "nvidia", or "gemini"). Uses deterministic fallback if both keys are blank.
AI_PROVIDER=auto
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Optional Gemini API key alternative (used if AI_PROVIDER=gemini or NVIDIA_API_KEY is empty)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Platform Nostr publisher key (64-char hex or nsec1...; dev keypair used if unset outside production)
PLATFORM_NOSTR_SECRET_KEY=
# Platform Nostr oracle key for Track A outcome attestations (kind 30079)
PLATFORM_ORACLE_SECRET_KEY=
# Comma-separated Nostr relays for broadcasting market events
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band
# Set to true to skip live WebSocket relay publishing (useful offline or in tests)
NOSTR_PUBLISH_DISABLED=false

# Lightning (LNbits). Leave empty in DEMO_MODE=true to use built-in simulated invoices
LNBITS_URL=
LNBITS_INVOICE_KEY=
LNBITS_ADMIN_KEY=
LNBITS_WEBHOOK_SECRET=

# Betting limits & invoice expiry
MIN_BET_SATS=10
MAX_BET_SATS=100000
INVOICE_EXPIRY_SEC=600

# Settlement fee (basis points on losing pool: 200 = 2%) & payout retry limit
PLATFORM_FEE_BPS=200
PAYOUT_MAX_RETRIES=3

# Track B Optimistic Nostr Oracle (leave pubkeys empty in DEMO_MODE=true for demo signers/admins)
ORACLE_SIGNER_PUBKEYS=
ADMIN_PUBKEYS=
CHALLENGE_WINDOW_SEC=3600
DISPUTE_BOND_SATS=1000

# Demo mode: fast worker ticks, 2-minute challenge windows, 5-minute BTC markets
DEMO_MODE=true
