{
  "name": "bitpredict-app",
  "version": "0.1.0",
  "private": true,
  "description": "BitPredict — Elysia Backend API, Scalar OpenAPI Docs, Nostr, Lightning & Dual-Track Oracle Engine",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:stress": "vitest run src/lib/__tests__/stress.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.3",
    "@elysiajs/openapi": "^1.4.17",
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.32",
    "nostr-tools": "^2.26.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "module": "src/index.ts"
}
