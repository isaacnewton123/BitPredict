# ---------------------------------------------------------------
# BitPredict Frontend Environment Variables (frontend/)
# Copy to .env (or .env.local) and adjust values for your environment.
# Full guide: ../docs/14-env-and-api-keys.md
# ---------------------------------------------------------------

# Elysia backend URL for Next.js /api/v1/* server-side proxy rewrites (next.config.ts).
# Matches the Elysia server port in ../app (default: http://localhost:3001).
BACKEND_URL=http://localhost:3001

# Client-side API base URL used by browser requests in frontend/lib/bitpredict-data.ts:
# - Set to "http://localhost:3001" for direct CORS requests to the Elysia backend.
# - Or set to "same-origin" to proxy through Next.js /api/v1/* rewrites.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Public URL where the frontend runs (used by wallet callbacks / links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated Nostr relays used by browser clients
NEXT_PUBLIC_NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.nostr.band
